{
  "name": "rosa-branca-theme",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:images && npm run build:fonts && vite build",
    "build:images": "node scripts/build-images.mjs",
    "build:fonts": "node scripts/convert-fonts.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:fonts",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"src/styles/**/*.css\"",
    "lint:fonts": "node scripts/lint-fonts.mjs"
  },
  "dependencies": {
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^4.3.4",
    "chrome-launcher": "^1.2.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "lighthouse": "^12.8.2",
    "sharp": "^0.35.4",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "vite": "^5.4.11",
    "wawoff2": "^2.0.1"
  }
}
